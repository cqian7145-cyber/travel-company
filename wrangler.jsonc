{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "china-closer",
  "main": "workers/index.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/stories",
      "/stories/*",
      "/experiences",
      "/experiences/*",
      "/voices",
      "/voices/*"
    ]
  },
  "vars": {
    "AI_ENABLED": "false",
    "DEEPSEEK_MODEL": "deepseek-flash"
  },
  "ratelimits": [
    {
      "name": "PLAN_RATE_LIMITER",
      "namespace_id": "817460231",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}

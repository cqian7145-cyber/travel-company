{
  "name": "china-closer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "cf:dev": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "wrangler": "4.158.0"
  }
}

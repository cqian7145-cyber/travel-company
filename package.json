{
  "name": "china-closer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "tsc --noEmit && vite build && node scripts/build-culture.mjs && node scripts/build-cities.mjs && node scripts/build-offline.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run data:check && npm run stories:check && npm run build && npm run test",
    "cf:dev": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:whoami": "wrangler whoami",
    "data:check": "node scripts/verify-data.mjs && node scripts/verify-hangzhou.mjs",
    "data:audit": "node scripts/verify-data.mjs --report",
    "data:version": "node scripts/stamp-data.mjs",
    "stories:check": "node scripts/validate-stories.mjs && node scripts/validate-highlights.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "wrangler": "4.158.0"
  }
}
